{
  "buildCommand": "pnpm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/api/v1/chat",
      "destination": "/api/v1/chat.js"
    },
    {
      "source": "/api/v1/content/(.*)",
      "destination": "/api/v1/content.js"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
} 